ex:comadre-fulozinha a ex:Guardiao ;
    ex:associadaABioma ex:Bioma_caatinga,
        ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:associadaAoPovo ex:Povo_potiguara ;
    ex:possuiCausoCompleto "Em uma das versões, ela é filha de um homem branco, rico e cruel, com uma mulher indígena de posição inferior na hierarquia colonial, uma união desigual, típica da violência que organizava as relações entre senhores e mulheres nativas. Quando a mãe morre, a menina, ainda criança, não tem para onde ir e para quem recorrer. É a própria mata que a recolhe. Ela cresce dentro da floresta e, ao crescer, toma para si o poder da natureza que a criou; não como dádiva, mas como vingança herdada: passa a punir com violência todo aquele que maltrata os animais e destrói a mata que um dia foi seu único lar."^^xsd:string ;
    ex:possuiCitacao ex:citacao_comadre-fulozinha_1 ;
    ex:possuiClassificacaoOriginal "Guardião"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiCultoVivo "culto da Jurema, no catimbó nordestino"^^xsd:string ;
    ex:possuiDescricao "Protetora feminina das matas do sertão nordestino, a Comadre Fulozinha usa o próprio cabelo, longo, negro, cobrindo o corpo inteiro, como arma contra quem entra na floresta sem deixar fumo e mel. Parente funcional da Caipora e do Curupira, mas com identidade regional que insiste em não se confundir com nenhum dos dois."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_al,
        ex:Estado_ce,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rn ;
    ex:possuiFonte ex:fonte_comadre-fulozinha_1,
        ex:fonte_comadre-fulozinha_2,
        ex:fonte_comadre-fulozinha_3 ;
    ex:possuiMatrizCultural ex:MatrizCultural_africana,
        ex:MatrizCultural_indigena ;
    ex:possuiNivelAmeaca "medio"^^xsd:string ;
    ex:possuiNome "Comadre Fulozinha"^^xsd:string ;
    ex:possuiOrigemIncerta true ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_comadre-fulozinha_1,
        ex:relacao_comadre-fulozinha_2,
        ex:relacao_comadre-fulozinha_3,
        ex:relacao_comadre-fulozinha_4 ;
    ex:possuiSlug "comadre-fulozinha"^^xsd:string ;
    ex:possuiTagline "\"Por isso não podemos chamá-la de caipora, senão ela nos bate com galhos de urtiga.\""^^xsd:string ;
    ex:possuiVariacao ex:variacao_comadre-fulozinha_entidade-da-jurema,
        ex:variacao_comadre-fulozinha_flor-da-mata-potiguara,
        ex:variacao_comadre-fulozinha_menina-perdida .

ex:mulher-de-branco a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_centro-oeste,
        ex:Regiao_nordeste,
        ex:Regiao_norte,
        ex:Regiao_sudeste,
        ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_norte ;
    ex:possuiCausoCompleto "Na versão mais contada nas estradas do país, o vulto branco aparece de repente no meio da pista, sozinho, pedindo carona ou apenas caminhando onde não há para onde ir. Assim que o carro se aproxima, ela desaparece. O motorista segue viagem tentando entender o que viu; até olhar pelo retrovisor e encontrá-la sentada no banco de trás, onde não estava um segundo antes. É nesse instante que a maioria perde o controle do veículo. Acidentes sem explicação aparente nas estradas sinuosas do interior brasileiro carregam, até hoje, essa suspeita não confirmada: talvez parte deles tenha a Mulher de Branco como causa, não a pista molhada ou o sono do motorista."^^xsd:string ;
    ex:possuiCitacao ex:citacao_mulher-de-branco_1,
        ex:citacao_mulher-de-branco_2 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "Vulto feminino de branco que surge em estradas desertas, cemitérios e adros de igreja depois da meia-noite. Pede carona, some da pista e reaparece no banco de trás do carro, o suficiente para tirar qualquer motorista do controle. Não é uma lenda única, mas uma família de mulheres trágicas com o mesmo figurino e o mesmo destino fatal para quem cruza seu caminho."^^xsd:string ;
    ex:possuiElemento ex:Elemento_ar,
        ex:Elemento_misticismo ;
    ex:possuiEstado ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_df,
        ex:Estado_go,
        ex:Estado_mg,
        ex:Estado_pa,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_pr,
        ex:Estado_rj,
        ex:Estado_rs,
        ex:Estado_sp ;
    ex:possuiFonte ex:fonte_mulher-de-branco_1,
        ex:fonte_mulher-de-branco_2 ;
    ex:possuiNivelAmeaca "alto"^^xsd:string ;
    ex:possuiNome "Mulher de Branco"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_mulher-de-branco_1,
        ex:relacao_mulher-de-branco_2,
        ex:relacao_mulher-de-branco_3,
        ex:relacao_mulher-de-branco_4,
        ex:relacao_mulher-de-branco_5,
        ex:relacao_mulher-de-branco_6 ;
    ex:possuiSlug "mulher-de-branco"^^xsd:string ;
    ex:possuiTagline "Olhe pelo retrovisor. Se ela estiver lá, já é tarde demais."^^xsd:string ;
    ex:possuiVariacao ex:variacao_mulher-de-branco_arquiteta-de-branco,
        ex:variacao_mulher-de-branco_dama-da-meia-noite,
        ex:variacao_mulher-de-branco_dama-do-museu-imperial,
        ex:variacao_mulher-de-branco_fidalga-dos-casaroes,
        ex:variacao_mulher-de-branco_galega-do-queixao,
        ex:variacao_mulher-de-branco_loura-do-bonfim,
        ex:variacao_mulher-de-branco_moca-sem-face,
        ex:variacao_mulher-de-branco_mulher-de-branco-de-noronha,
        ex:variacao_mulher-de-branco_noiva-da-estrada,
        ex:variacao_mulher-de-branco_noiva-da-santa-rita,
        ex:variacao_mulher-de-branco_noiva-de-mogi,
        ex:variacao_mulher-de-branco_noiva-do-carmo,
        ex:variacao_mulher-de-branco_noiva-do-jardim,
        ex:variacao_mulher-de-branco_velhinha-do-morro-do-comum .

ex:pai-do-mangue a ex:Guardiao ;
    ex:associadaABioma ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:associadaAoPovo ex:Povo_potiguara ;
    ex:possuiCausoCompleto """Nos relatos recolhidos nas aldeias Jacaré de César e Três Rios, o Pai do Mangue é o ser que habita os manguezais do território potiguara e é considerado dono daquele espaço. Seu Orlando Soares o descreve como "um homão" de chapéu vermelho e diz que ele é o bicho mais perigoso que tem: se o pescador chega ao mangue e fala o nome dele, não pega um peixe. Orlando lembra a noite em que a mãe começou a chamar nome, a xingar, porque algo estava espantando os peixes; o colvo zoava de peixe e, quando iam ver, não tinha nenhum. Ele avisou que ela não devia ter xingado o Pai do Mangue, e ficaram lá até amanhecer, porque sair no escuro seria se perder.

Dona Zita, de Três Rios, conta que ele não perturba quem ele quer que pesque; quando não quer, fica pescando também, e a pessoa ouve outra pessoa pescando e não pega nada. Ela diz que o viu com várias pessoas no alto da Boa Vista: um facho de fogo na cabeça, pequenininho quando descia e grande quando subia, cada vez mais perto, até todos correrem para o cemitério. O cacique Cí, de Três Rios, diz que já o viu na ladeira do porto, quando ali ainda havia mata: uma tochinha que ia crescendo e aumentando o brilho à medida que a pessoa se aproximava. Para ele, o Pai do Mangue aparece a quem não acredita, e faz o pescador que desdenha voltar do jeito que entrou, sem nada para os filhos."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_pai-do-mangue_1 ;
    ex:possuiClassificacaoOriginal "Guardião"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "Entre os Potiguara do litoral norte da Paraíba, o Pai do Mangue é o dono do manguezal. Quem entra ali para pescar ou catar marisco segue as regras dele: não chamar nome, isto é, não dizer palavrão, e não desacreditar. Quando quer, ele deixa pescar; quando não quer, espanta os peixes, pesca junto com o pescador sem que se veja quem é, e pode fazer a pessoa se perder e não conseguir sair do mangue. Uns o descrevem como espírito, outros como um homem negro enorme de chapéu vermelho, outros como uma tocha de fogo que cresce."^^xsd:string ;
    ex:possuiElemento ex:Elemento_agua,
        ex:Elemento_fogo ;
    ex:possuiEstado ex:Estado_ce,
        ex:Estado_pb ;
    ex:possuiFonte ex:fonte_pai-do-mangue_1,
        ex:fonte_pai-do-mangue_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_indigena ;
    ex:possuiNivelAmeaca "alto"^^xsd:string ;
    ex:possuiNome "O Pai do Mangue"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "epico"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_pai-do-mangue_1,
        ex:relacao_pai-do-mangue_2,
        ex:relacao_pai-do-mangue_3 ;
    ex:possuiSlug "pai-do-mangue"^^xsd:string ;
    ex:possuiTagline "Quem fala palavrão no mangue ou duvida dele volta sem peixe, ou fica perdido até o dia amanhecer. No escuro da maré, alguém pesca ao lado, e não é gente."^^xsd:string ;
    ex:possuiVariacao ex:variacao_pai-do-mangue_guajara .

