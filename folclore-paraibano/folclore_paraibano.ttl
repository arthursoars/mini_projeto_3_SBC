    ex:possuiSlug "curupira"^^xsd:string .

ex:homem-do-saco a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga,
        ex:Bioma_cerrado,
        ex:Bioma_mata-atlantica,
        ex:Bioma_pampa ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_nordeste,
        ex:Regiao_sudeste,
        ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_sudeste ;
    ex:possuiCausoCompleto """Quando a luz alaranjada do crepúsculo começa a ceder lugar às sombras nas ruas dos bairros residenciais, as mães costumavam interromper as brincadeiras infantis nas calçadas com uma ordem firme: "Entrem logo, que o Homem do Saco já vai passar".

Diferente das criaturas fantásticas das matas virgens que exigem florestas densas para habitar, o Homem do Saco é o terror concreto do asfalto, do paralelepípedo e dos terrenos baldios. Apresenta-se como um andarilho decrépito, com casaco longo ensebado, chapéu puído abaixado sobre a testa e uma postura curvada sob o peso de um enorme saco de aniagem que arrasta pelas costas.

A tradição popular alerta que seu andar lento e claudicante é mero disfarce: bastava uma criança distraída afastar-se da soleira de casa ou adentrar um beco deserto para o velho demonstrar uma agilidade sobrenatural. Com um bote rápido e silencioso, cobria a cabeça da vítima com a boca do saco, enfiava-a lá dentro e desaparecia virando a primeira esquina sem deixar qualquer rastro. O destino das crianças aprisionadas variava entre os relatos: levadas para terras distantes, transformadas em sabão ou mantidas sob cativeiro secreto."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_homem-do-saco_1,
        ex:citacao_homem-do-saco_2 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "O mais temido mito de controle social infantil dos centros urbanos e subúrbios brasileiros. Descrito por Câmara Cascudo como o \"lobisomem da cidade\", manifesta-se como um velho maltrapilho e encurvado que caminha silenciosamente ao cair da tarde carregando às costas um saco de estopa encardido, espreitando crianças desobedientes que desrespeitam os horários e permanecem sozinhas nas calçadas desertas."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_go,
        ex:Estado_mg,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rj,
        ex:Estado_rs,
        ex:Estado_sp ;
    ex:possuiFonte ex:fonte_homem-do-saco_1 ;
    ex:possuiMatrizCultural ex:MatrizCultural_iberica ;
    ex:possuiNivelAmeaca "alto"^^xsd:string ;
    ex:possuiNome "Homem do Saco"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_homem-do-saco_1,
        ex:relacao_homem-do-saco_2,
        ex:relacao_homem-do-saco_3,
        ex:relacao_homem-do-saco_4,
        ex:relacao_homem-do-saco_5 ;
    ex:possuiSlug "homem-do-saco"^^xsd:string ;
    ex:possuiTagline "Quem fica brincando na rua até escurecer acaba dentro do saco."^^xsd:string ;
    ex:possuiVariacao ex:variacao_homem-do-saco_andarilho-dos-becos,
        ex:variacao_homem-do-saco_cirandeiro-da-estola,
        ex:variacao_homem-do-saco_maria-grampinho,
        ex:variacao_homem-do-saco_o-velho-da-kombi-branca,
        ex:variacao_homem-do-saco_velho-do-saco-de-fortaleza .

