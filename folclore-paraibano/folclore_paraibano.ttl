ex:alma-de-gato a ex:Metamorfo ;
    ex:associadaABioma ex:Bioma_cerrado,
        ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_centro-oeste,
        ex:Regiao_nordeste,
        ex:Regiao_norte,
        ex:Regiao_sudeste,
        ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_norte ;
    ex:possuiCausoCompleto "Em noites silenciosas, quando alguma criança faz birra demais, grita demais ou se recusa a dormir, é quando ele tende a se manifestar; na forma própria de um gato, olhos brilhantes cortando a escuridão do quarto ou do quintal. Não ataca, não fala, não se move contra ninguém. Apenas observa. Fica ali, no silêncio, até que a criança perceba a presença e volte a se comportar. Restaurada a obediência, ele desaparece do mesmo jeito que chegou, sem deixar rastro que prove que esteve ali."^^xsd:string ;
    ex:possuiCitacao ex:citacao_alma-de-gato_1 ;
    ex:possuiClassificacaoOriginal "Metamorfo"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiDescricao "Presença noturna de origem indígena que aparece como um gato de olhos brilhantes para silenciar crianças em birra, o Alma-de-Gato empresta o nome, e talvez a origem, a um pássaro real de canto parecido com gemido felino. Ninguém documentou um único mal causado por ele. Ninguém, também, ousou desafiá-lo para descobrir se isso é coragem ou sorte."^^xsd:string ;
    ex:possuiElemento ex:Elemento_ar,
        ex:Elemento_misticismo ;
    ex:possuiEstado ex:Estado_pb,
        ex:Estado_rn ;
    ex:possuiFonte ex:fonte_alma-de-gato_1,
        ex:fonte_alma-de-gato_2,
        ex:fonte_alma-de-gato_3 ;
    ex:possuiMatrizCultural ex:MatrizCultural_indigena ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "Alma-de-Gato"^^xsd:string ;
    ex:possuiOrigemIncerta true ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_alma-de-gato_1,
        ex:relacao_alma-de-gato_2 ;
    ex:possuiSlug "alma-de-gato"^^xsd:string ;
    ex:possuiTagline "\"Um vulto, um calafrio, uma porta que se fecha…\""^^xsd:string ;
    ex:possuiVariacao ex:variacao_alma-de-gato_passaro-agouro .

ex:boi-da-cara-preta a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga,
        ex:Bioma_cerrado,
        ex:Bioma_mata-atlantica,
        ex:Bioma_pampa ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_nordeste,
        ex:Regiao_sudeste,
        ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto """Não existe brasileiro que não tenha adormecido na infância ao som dolente e arrastado da cantiga que atravessou séculos de tradição oral: _"Boi, boi, boi, boi da cara preta..."_

Estudado pelo antropólogo e folclorista Luís da Câmara Cascudo e pelo musicólogo Mário de Andrade, o Boi da Cara Preta é o bicho-papão rural por excelência. Diferente dos touros comuns de pasto, esta criatura possui natureza espectral e tamanho variável. Seu corpo é magro e esguio, coberto por pelos cinzentos e poeirentos, mas sua cabeça é marcada por uma pigmentação de treva impenetrável, uma máscara negra aveludada onde dois olhos redondos de fogo brando observam pelas frestas das janelas de madeira.

O Boi da Cara Preta não arromba portas nem destrói paredes com fúria cega: ele desliza pelas sombras do curral e sobe silenciosamente nos caibros do telhado, emitindo um mugido abafado e cavernoso que ressoa como vento encanado. Ele é atraído especificamente pelas caretas, birras e pelo choro caprichoso das crianças na hora do descanso. Bastam os versos da cantiga entoados com voz firme para que o vulto se desfaça na escuridão da noite, lembrando aos pequenos que o repouso é a única salvaguarda contra os monstros da madrugada."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_boi-da-cara-preta_1,
        ex:citacao_boi-da-cara-preta_2 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "A mais antiga e onipresente assombração infantil do cancioneiro tradicional brasileiro. O Boi da Cara Preta é uma entidade taurina espectral de pelagem cinzenta e máscara facial de negro absoluto, cujos olhos cintilam no topo dos muros, cercas e telhados coloniais. Invocado nas cantigas de ninar pelas amas e mães de todo o país, ele ronda as casas silenciosas para levar embora os infantes teimosos que recusam o sono."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_mg,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rj,
        ex:Estado_rn,
        ex:Estado_rs,
        ex:Estado_sp ;
    ex:possuiFonte ex:fonte_boi-da-cara-preta_1,
        ex:fonte_boi-da-cara-preta_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_iberica ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "Boi da Cara Preta"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_boi-da-cara-preta_1,
        ex:relacao_boi-da-cara-preta_2 ;
    ex:possuiSlug "boi-da-cara-preta"^^xsd:string ;
    ex:possuiTagline "Boi, boi, boi... boi da cara preta, pega essa criança que tem medo de careta."^^xsd:string ;
    ex:possuiVariacao ex:variacao_boi-da-cara-preta_guardiao-dos-telhados,
        ex:variacao_boi-da-cara-preta_touro-da-meia-noite .

ex:boitata a ex:EntidadeFolclorica ;
    ex:possuiNome "Boitatá"^^xsd:string ;
    ex:possuiSlug "boitata"^^xsd:string .

ex:caboclo-boiadeiro a ex:Encantado ;
    ex:associadaABioma ex:Bioma_caatinga,
        ex:Bioma_cerrado ;
    ex:associadaABiomaPrincipal ex:Bioma_cerrado ;
    ex:associadaARegiao ex:Regiao_centro-oeste,
        ex:Regiao_nordeste,
        ex:Regiao_sudeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto """Em todas as estradas poeirentas de gado que cruzam o sertão da Bahia, as campinas de Minas Gerais e os cerrados de Goiás, o estalar de um chicote invisível no ar e o aboio melancólico ecoando nas serras são sinais inequívocos da passagem do Caboclo Boiadeiro. Documentado por folcloristas pioneiros como Edison Carneiro e Câmara Cascudo, ele é o arquétipo sagrado do homem do campo que domou a caatinga e o gado bravo.

A lenda conta que o Boiadeiro foi o primeiro e mais destemido vaqueiro que já pisou na terra. Ao morrer em uma disparada lendária salvando sua tropa de uma enchente repentina ou de um despenhadeiro, foi acolhido pelas forças encantadas da terra. Ele não partiu para o descanso comum: transformou-se no guardião eterno das trilhas de gado e dos homens que vivem no lombo do cavalo.

Montado em seu baio ligeiro, o Caboclo Boiadeiro galopa pelas chapadas nas tardes de trovoada. Ele traz no ombro o laço trançado de couro cru com doze braças de comprimento. Com esse laço sagrado, ele não amansa apenas os touros mais bravios e mandingueiros da caatinga: ele laça as ventanias furiosas, doma raios e dissipa nuvens de gafanhotos. Quando um vaqueiro cai ferido no espinheiro ou um rebanho se dispersa na escuridão de uma tempestade no cerrado, o Boiadeiro surge no horizonte soltando seu aboio estridente (_"Êeeea, booooi..."_), reunindo o gado disperso e salvando o sertanejo com sua presença protetora."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_caboclo-boiadeiro_1,
        ex:citacao_caboclo-boiadeiro_2 ;
    ex:possuiClassificacaoOriginal "Encantado"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "A figura mítica suprema do vaqueiro ancestral no folclore do sertão e na Encantaria brasileira. O Caboclo Boiadeiro é a personificação espiritual da coragem, da rusticidade e do domínio sobre os ermos e rebanhos. Montado em um cavalo vigoroso que não deixa rastros na terra seca, ele veste gibão e perneiras de couro cru, maneja um laço de couro mágico capaz de laçar ventos e tempestades e guia viajantes perdidos em meio à fúria das secas e dos temporais."^^xsd:string ;
    ex:possuiElemento ex:Elemento_ar,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_al,
        ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_go,
        ex:Estado_ma,
        ex:Estado_mg,
        ex:Estado_ms,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_pi,
        ex:Estado_rn ;
    ex:possuiFonte ex:fonte_caboclo-boiadeiro_1,
        ex:fonte_caboclo-boiadeiro_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_moderna ;
    ex:possuiNivelAmeaca "medio"^^xsd:string ;
    ex:possuiNome "Caboclo Boiadeiro"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_caboclo-boiadeiro_1,
        ex:relacao_caboclo-boiadeiro_2 ;
    ex:possuiSlug "caboclo-boiadeiro"^^xsd:string ;
    ex:possuiTagline "Com gibão de couro curtido e laço de doze braças, ele tange o gado encantado e amansa as ventanias do sertão."^^xsd:string ;
    ex:possuiVariacao ex:variacao_caboclo-boiadeiro_boiadeiro-da-jurema,
        ex:variacao_caboclo-boiadeiro_boiadeiro-lacador-do-sertao .

ex:carneirinho-de-ouro a ex:EntidadeFolclorica ;
