ex:fogo-corredor a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste,
        ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:associadaAoPovo ex:Povo_tupi ;
    ex:possuiCausoCompleto "O fogo aparece de repente na estrada e passa a correr atrás de quem caminha sozinho. Quem se depara com ele no escuro do sertão aprende rápido a não correr de volta."^^xsd:string ;
    ex:possuiCitacao ex:citacao_fogo-corredor_1 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "Bolas de fogo que correm pelas estradas de terra do sertão, perseguindo quem viaja sozinho à noite. No Nordeste, ganham nome próprio, Fogo Corredor, ou Batatão, e uma explicação que o Boitatá do Sul nunca teve: são almas de amores proibidos e de crianças mortas sem batismo, presas entre o castigo e o perdão."^^xsd:string ;
    ex:possuiElemento ex:Elemento_fogo,
        ex:Elemento_misticismo ;
    ex:possuiEstado ex:Estado_al,
        ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_mg,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rn,
        ex:Estado_se ;
    ex:possuiFonte ex:fonte_fogo-corredor_1,
        ex:fonte_fogo-corredor_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_indigena ;
    ex:possuiNivelAmeaca "medio"^^xsd:string ;
    ex:possuiNome "Fogo Corredor (Batatão)"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_fogo-corredor_1,
        ex:relacao_fogo-corredor_2,
        ex:relacao_fogo-corredor_3,
        ex:relacao_fogo-corredor_4,
        ex:relacao_fogo-corredor_5,
        ex:relacao_fogo-corredor_6 ;
    ex:possuiSlug "fogo-corredor"^^xsd:string ;
    ex:possuiTagline "\"Não se vê outra coisa senão um facho cintilante correndo para ali.\""^^xsd:string ;
    ex:possuiVariacao ex:variacao_fogo-corredor_bata-mineiro,
        ex:variacao_fogo-corredor_batatao-potiguara,
        ex:variacao_fogo-corredor_biatata-da-bahia,
        ex:variacao_fogo-corredor_jean-de-la-foice,
        ex:variacao_fogo-corredor_joao-galafuz,
        ex:variacao_fogo-corredor_luzerna .

