ex:pai-mateus a ex:Guardiao ;
    ex:associadaABioma ex:Bioma_caatinga ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto "Conta a lenda, segundo o verbete da Wikipédia, que Pai Mateus seria um ermitão curandeiro que viveu naquela região por volta do século XVIII e era destino de muitas pessoas que o procuravam para se consultar. Não há outro registro do que ele fazia, nem de como ou quando morreu; ficou o nome do lugar."^^xsd:string ;
    ex:possuiCitacao ex:citacao_pai-mateus_1 ;
    ex:possuiClassificacaoOriginal "Guardião"^^xsd:string ;
    ex:possuiConfianca "baixa"^^xsd:string ;
    ex:possuiDescricao "O Lajedo de Pai Mateus é um campo de grandes pedras arredondadas na zona rural de Cabaceiras, no Cariri da Paraíba. Conta a lenda que ali viveu, por volta do século XVIII, um ermitão curandeiro chamado Pai Mateus, procurado por muitas pessoas que iam se consultar com ele. O nome ficou na pedra."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_pb ;
    ex:possuiFonte ex:fonte_pai-mateus_1 ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "Pai Mateus"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiSlug "pai-mateus"^^xsd:string ;
    ex:possuiTagline "Entre as pedras redondas do Cariri paraibano morava um ermitão que curava. Gente de longe vinha se consultar com ele, e o lajedo ficou com o seu nome."^^xsd:string .

