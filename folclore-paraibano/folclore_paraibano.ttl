@prefix ex: <https://w3id.org/folclore-paraibano/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/folclore-paraibano/ontology> a owl:Ontology ;
    rdfs:label "Ontologia do Folclore Paraibano"@pt-br ;
    rdfs:comment "Ontologia sobre entidades do folclore associadas à Paraíba, construída a partir da API Encantaria Digital."@pt-br ;
    owl:versionInfo "1.0" .

ex:aipo-e-tambia a ex:Origem ;
    ex:associadaABioma ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto """A lenda indígena sobre o parque, conta o verbete da Wikipédia, trata do amor entre dois jovens de tribos rivais: a índia Aipó, filha de um cacique potiguara, e o valente guerreiro Tambiá, da tribo cariri. A inimizade entre os dois povos impedia o casamento. Feito prisioneiro, Tambiá recebeu como "esposa da morte" a filha do inimigo. Executado na floresta, teve a última mensagem da amada: durante cinquenta luas, ela chorou sobre a tumba dele. Do pranto dela nasceu a fonte do sítio, chamada a partir daí Fonte Tambiá.

O livro «O que o vento não levou», citado no verbete, conta de outro jeito: a índia era tabajara e se chamava Iapré, e, chorando a morte do amado enterrado ali, fez nascer uma fonte de água de excelente qualidade, na qual enxugava as lágrimas da saudade com os seus imensos cabelos."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_aipo-e-tambia_1 ;
    ex:possuiClassificacaoOriginal "Origem"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiDescricao "Lenda de origem da fonte do Parque Arruda Câmara, a Bica, em João Pessoa. A jovem Aipó, filha de um cacique potiguara, e o guerreiro Tambiá, da tribo cariri, se amavam, mas a inimizade entre os povos impedia o casamento. Feito prisioneiro, Tambiá recebeu a filha do inimigo como \"esposa da morte\" e foi executado na floresta. Aipó chorou sobre a tumba dele durante cinquenta luas, e do seu pranto nasceu a fonte, chamada desde então Fonte Tambiá."^^xsd:string ;
    ex:possuiElemento ex:Elemento_agua,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_pb ;
    ex:possuiFonte ex:fonte_aipo-e-tambia_1 ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "Aipó e Tambiá"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiSlug "aipo-e-tambia"^^xsd:string ;
    ex:possuiTagline "Ele era cariri, ela era filha de cacique inimigo. Executaram o guerreiro na mata, e o choro dela sobre a cova virou a fonte que deu água a João Pessoa."^^xsd:string .

