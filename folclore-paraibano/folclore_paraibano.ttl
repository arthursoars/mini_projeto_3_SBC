ex:bruxa a ex:Metamorfo ;
    ex:associadaABioma ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_sul ;
    ex:associadaARegiaoPrincipal ex:Regiao_sul ;
    ex:associadaAoPovo ex:Povo_acorianos ;
    ex:possuiCausoCompleto "Foi em Florianópolis, porém, que a lenda ganhou sua expressão mais rica e mais brasileira: ali, contam, as bruxas roubam embarcações de pescadores à noite, transformam-se em borboletas gigantes para vigiar sem serem vistas, e dão nós indesatáveis nas crinas dos cavalos como assinatura de sua passagem, um dano pequeno, quase brincalhão, que ao mesmo tempo avisa: alguém esteve aqui, e não era humano."^^xsd:string ;
    ex:possuiCitacao ex:citacao_bruxa_1 ;
    ex:possuiClassificacaoOriginal "Metamorfo"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiDescricao "Figura universal do imaginário humano, a Bruxa ganhou rosto próprio na Ilha de Santa Catarina com a colonização açoriana: mulheres que se transformam em coruja, morcego ou mariposa negra, roubam embarcações e sequestram crianças que não dormem. Foi o pesquisador Franklin Cascaes quem, por trinta anos, transformou os relatos orais da ilha em acervo documentado."^^xsd:string ;
    ex:possuiElemento ex:Elemento_ar,
        ex:Elemento_misticismo ;
    ex:possuiEstado ex:Estado_pb,
        ex:Estado_pr,
        ex:Estado_rs,
        ex:Estado_sc ;
    ex:possuiFonte ex:fonte_bruxa_1,
        ex:fonte_bruxa_2,
        ex:fonte_bruxa_3 ;
    ex:possuiMatrizCultural ex:MatrizCultural_iberica ;
    ex:possuiNivelAmeaca "alto"^^xsd:string ;
    ex:possuiNome "Bruxa (Bruxas de Florianópolis)"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "epico"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_bruxa_1,
        ex:relacao_bruxa_2,
        ex:relacao_bruxa_3,
        ex:relacao_bruxa_4,
        ex:relacao_bruxa_5 ;
    ex:possuiSlug "bruxa"^^xsd:string ;
    ex:possuiTagline "Cumprimenta-se apenas com a mão esquerda; sinal, dizem, de quem faz pacto com o que não se nomeia."^^xsd:string ;
    ex:possuiVariacao ex:variacao_bruxa_baile-das-bruxas-de-itaguacu,
        ex:variacao_bruxa_bruxa-da-aldeia-sao-miguel,
        ex:variacao_bruxa_bruxa-guaratuba,
        ex:variacao_bruxa_bruxa-metamorfa,
        ex:variacao_bruxa_bruxas-de-coqueirinho .

ex:cuca a ex:EntidadeFolclorica ;
    ex:possuiNome "Cuca"^^xsd:string ;
    ex:possuiSlug "cuca"^^xsd:string .

