ex:botija a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga,
        ex:Bioma_mata-atlantica ;
    ex:associadaABiomaPrincipal ex:Bioma_mata-atlantica ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto """O problema é que quem enterrava a própria fortuna muitas vezes morria antes de contar a alguém onde a tinha escondido. Morte súbita, acidente, doença, violência; o segredo ia junto para debaixo da terra, e a alma, incapaz de descansar enquanto o dinheiro continuasse perdido e sem destino, ficava penando. É nesse ponto que a lenda começa de verdade: a alma escolhe alguém, quase sempre um vivo de índole honesta, ou alguém que precisa da ajuda mais do que qualquer outro na região, e aparece em sonho, repetidamente, entregando pistas até revelar o lugar exato onde a botija está enterrada.

A revelação em sonho vem sempre amarrada a uma regra, e a regra não perdoa desvio nenhum: o escolhido precisa ir sozinho até o local, de preferência à meia-noite, sem levar ninguém junto, sem contar a ninguém antes, nem à esposa, nem ao melhor amigo, nem ao padre, a não ser que a própria instrução do sonho autorize. Precisa cavar em silêncio absoluto e sem sentir medo, por mais que a escuridão, o barulho da mata ou a própria consciência da presença de uma alma penada testando cada passo tentem provocar justamente esse medo. Quebrar qualquer uma dessas condições, hesitar, gritar, contar o plano antes de completar a busca, custa o prêmio inteiro: o ouro que estava ali, brilhando, se transforma em carvão, em pedra, ou em cacos de telha diante dos próprios olhos do buscador, como se a terra recusasse entregar riqueza a quem não provou merecer o silêncio que ela exigiu."""^^xsd:string ;
    ex:possuiCitacao ex:citacao_botija_1 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiDescricao "Almas presas por um segredo, onde enterraram fortuna em vida, aparecem em sonho para revelar o esconderijo a um escolhido. A regra é rígida: desenterrar sozinho, à meia-noite, sem medo e sem contar a ninguém. Quebrar qualquer parte dela transforma o ouro em carvão diante dos próprios olhos."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_ce,
        ex:Estado_go,
        ex:Estado_mg,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rn,
        ex:Estado_sp ;
    ex:possuiFonte ex:fonte_botija_1,
        ex:fonte_botija_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_iberica ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "A Botija"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_botija_1,
        ex:relacao_botija_2,
        ex:relacao_botija_3,
        ex:relacao_botija_4,
        ex:relacao_botija_5,
        ex:relacao_botija_6,
        ex:relacao_botija_7 ;
    ex:possuiSlug "botija"^^xsd:string ;
    ex:possuiTagline "\"Se sentir medo ou contar a alguém, o ouro se transforma em carvão.\""^^xsd:string ;
    ex:possuiVariacao ex:variacao_botija_botija-de-itarema,
        ex:variacao_botija_botija-de-jararaca,
        ex:variacao_botija_ceara-mirim-canguaretama,
        ex:variacao_botija_garrafas-de-ouro-de-pirenopolis,
        ex:variacao_botija_regiao-mineradora,
        ex:variacao_botija_rio-formoso,
        ex:variacao_botija_serra-da-rajada,
        ex:variacao_botija_setima-cajazeira .

ex:cangaceiros-fantasmas a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto "Nas rotas antigas que os bandos percorriam, sobretudo nos pontos onde a história registra emboscadas, armadas pelos próprios cangaceiros ou, como em Angicos, armadas contra eles, consolidou-se entre os moradores do sertão a crença de que, em noites de lua cheia, é possível ouvir o bando inteiro voltando a existir por alguns minutos: o tropel de dezenas de cascos batendo na terra seca, o estampido do bacamarte e do rifle Winchester, os gritos de homens e mulheres em combate."^^xsd:string ;
    ex:possuiCitacao ex:citacao_cangaceiros-fantasmas_1 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "Nas trilhas onde o bando de Lampião armou emboscadas ou foi emboscado, moradores dizem escutar, em noites de lua cheia, o tropel de cavalos, tiros de bacamarte e os gritos de um combate que a história já registrou como encerrado. O Cangaço acabou há quase um século, mas nas estradas do sertão, a violência real daqueles anos ainda ecoa, como se o bando reencenasse, para sempre, a própria guerra."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_al,
        ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rn,
        ex:Estado_se ;
    ex:possuiFonte ex:fonte_cangaceiros-fantasmas_1,
        ex:fonte_cangaceiros-fantasmas_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_moderna ;
    ex:possuiNivelAmeaca "medio"^^xsd:string ;
    ex:possuiNome "Cangaceiros Fantasmas"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "mitico"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_cangaceiros-fantasmas_1,
        ex:relacao_cangaceiros-fantasmas_2,
        ex:relacao_cangaceiros-fantasmas_3 ;
    ex:possuiSlug "cangaceiros-fantasmas"^^xsd:string ;
    ex:possuiTagline "\"O sertanejo tem sempre nos lábios uma expressão de descrença.\""^^xsd:string ;
    ex:possuiVariacao ex:variacao_cangaceiros-fantasmas_memorial-da-resistencia,
        ex:variacao_cangaceiros-fantasmas_rotas-do-cangaco .

ex:carro-de-boi-assombrado a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto "É madrugada, a casa está fechada, e o morador acorda ou já está acordado quando o rangido começa a se aproximar; distante no início, depois cada vez mais nítido, o eixo gemendo, as rodas arrastando na terra seca, e por cima de tudo isso a voz cantada do carreiro, arrastada, quase um lamento. O som cresce como se o carro estivesse passando bem em frente à casa. Quem tem coragem de espiar pela janela ou correr até a estrada encontra apenas terra vazia. Nenhuma marca de roda no chão, nenhuma poeira levantada, nenhum vulto se afastando. O som simplesmente cessa, como se tivesse entrado num ponto da estrada e desaparecido junto com o silêncio que volta em seguida."^^xsd:string ;
    ex:possuiCitacao ex:citacao_carro-de-boi-assombrado_1,
        ex:citacao_carro-de-boi-assombrado_2 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "media"^^xsd:string ;
    ex:possuiDescricao "Nas madrugadas silenciosas do sertão, moradores ouvem o rangido lento das rodas de madeira e o canto arrastado de um carreiro que já não existe. Não há carro, não há boi, não há homem; apenas o som, atravessando estradas de terra que a memória do gado ainda insiste em percorrer."^^xsd:string ;
    ex:possuiElemento ex:Elemento_ar,
        ex:Elemento_misticismo ;
    ex:possuiEstado ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_go,
        ex:Estado_mg,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_pr,
        ex:Estado_rj,
        ex:Estado_rn,
        ex:Estado_sp ;
    ex:possuiFonte ex:fonte_carro-de-boi-assombrado_1,
        ex:fonte_carro-de-boi-assombrado_2 ;
    ex:possuiNivelAmeaca "baixo"^^xsd:string ;
    ex:possuiNome "Carro de Boi Assombrado"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "comum"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_carro-de-boi-assombrado_1,
        ex:relacao_carro-de-boi-assombrado_2,
        ex:relacao_carro-de-boi-assombrado_3 ;
    ex:possuiSlug "carro-de-boi-assombrado"^^xsd:string ;
    ex:possuiTagline "Na estrada vazia, o rangido chega antes da poeira, e a poeira nunca chega."^^xsd:string ;
    ex:possuiVariacao ex:variacao_carro-de-boi-assombrado_carreto-da-madrugada,
        ex:variacao_carro-de-boi-assombrado_carro-caido,
        ex:variacao_carro-de-boi-assombrado_cortejo-das-minas .

ex:papa-figo a ex:Assombracao ;
    ex:associadaABioma ex:Bioma_caatinga ;
    ex:associadaABiomaPrincipal ex:Bioma_caatinga ;
    ex:associadaARegiao ex:Regiao_nordeste ;
    ex:associadaARegiaoPrincipal ex:Regiao_nordeste ;
    ex:possuiCausoCompleto "O Papa-Figo age no fim de tarde, na hora exata em que as escolas soltam os alunos, o momento em que uma criança fica mais tempo desacompanhada na rua. Oferece doces, brinquedos, qualquer isca que funcione, e conduz a vítima a um lugar deserto. Ali, arremessa-a dentro de um saco. Ninguém mais vê essa criança."^^xsd:string ;
    ex:possuiCitacao ex:citacao_papa-figo_1 ;
    ex:possuiClassificacaoOriginal "Assombração"^^xsd:string ;
    ex:possuiConfianca "alta"^^xsd:string ;
    ex:possuiDescricao "Não é fera, não é encanto, não é maldição: é um homem doente, de verdade, que ronda a saída das escolas oferecendo doces. O Papa-Figo acredita que o fígado de crianças cura a moléstia que o consome, e é, entre todos os monstros deste acervo, o mais próximo de ter existido."^^xsd:string ;
    ex:possuiElemento ex:Elemento_misticismo,
        ex:Elemento_terra ;
    ex:possuiEstado ex:Estado_ba,
        ex:Estado_ce,
        ex:Estado_pb,
        ex:Estado_pe,
        ex:Estado_rn ;
    ex:possuiFonte ex:fonte_papa-figo_1,
        ex:fonte_papa-figo_2 ;
    ex:possuiMatrizCultural ex:MatrizCultural_iberica ;
    ex:possuiNivelAmeaca "extremo"^^xsd:string ;
    ex:possuiNome "Papa-Figo"^^xsd:string ;
    ex:possuiOrigemIncerta false ;
    ex:possuiRaridade "raro"^^xsd:string ;
    ex:possuiRelacaoRegistrada ex:relacao_papa-figo_1,
        ex:relacao_papa-figo_2,
        ex:relacao_papa-figo_3,
        ex:relacao_papa-figo_4,
        ex:relacao_papa-figo_5 ;
    ex:possuiSlug "papa-figo"^^xsd:string ;
    ex:possuiTagline "Velho, sujo, faminto, e convencido de que o fígado de uma criança cura o que a medicina não consegue."^^xsd:string ;
    ex:possuiVariacao ex:variacao_papa-figo_coronel-do-engenho,
        ex:variacao_papa-figo_velho-do-saco-urbano .

