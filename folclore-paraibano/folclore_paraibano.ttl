ex:relacao_mulher-de-branco_5 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:mula-sem-cabeca ;
    ex:entidadeOrigem ex:mulher-de-branco ;
    ex:motivoRelacao "Outra maldição feminina ligada a transgressão amorosa que se manifesta em estradas e caminhos noturnos"^^xsd:string ;
    ex:tipoRelacao "elemental_kin"^^xsd:string .

ex:relacao_mulher-de-branco_6 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:princesa-encantada-de-jericoacoara ;
    ex:entidadeOrigem ex:mulher-de-branco ;
    ex:motivoRelacao "Outra figura feminina de branco/dourado ligada a espera e maldição, mas passiva e não hostil; espera ser salva, não causa acidentes nem persegue quem se aproxima"^^xsd:string ;
    ex:tipoRelacao "rival"^^xsd:string .

ex:relacao_pai-do-mangue_1 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:comadre-fulozinha ;
    ex:entidadeOrigem ex:pai-do-mangue ;
    ex:motivoRelacao "A dissertação de Milena Veríssimo Barbosa trata os dois como seres que governam, com regras, o mangue e a mata do território potiguara."^^xsd:string ;
    ex:tipoRelacao "companion"^^xsd:string .

ex:relacao_pai-do-mangue_2 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:fogo-corredor ;
    ex:entidadeOrigem ex:pai-do-mangue ;
    ex:motivoRelacao "Para o cacique Cí e para dona Zita, o Batatão, a bola de fogo, é o próprio Pai do Mangue."^^xsd:string ;
    ex:tipoRelacao "companion"^^xsd:string .

ex:relacao_pai-do-mangue_3 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:sopinha-e-cu-de-fogo ;
    ex:entidadeOrigem ex:pai-do-mangue ;
    ex:motivoRelacao "Parentesco de traço: na mesma tradição potiguara, o Pai do Mangue protege o mangue e a dupla derruba e queima a mata."^^xsd:string ;
    ex:tipoRelacao "companion"^^xsd:string .

ex:relacao_pai-do-mato_1 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:caipora ;
    ex:entidadeOrigem ex:pai-do-mato ;
    ex:motivoRelacao "Mesma família funcional de guardiões da mata; Pai-do-Mato tem porte de gigante e ponto fraco próprio, distinto da montaria e do pedágio da Caipora"^^xsd:string ;
    ex:tipoRelacao "variant"^^xsd:string .

ex:relacao_pai-do-mato_2 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:capelobo ;
    ex:entidadeOrigem ex:pai-do-mato ;
    ex:motivoRelacao "Compartilha o ponto fraco no umbigo, traço que o próprio material de origem lê como sinal de parentesco entre monstros brasileiros"^^xsd:string ;
    ex:tipoRelacao "elemental_kin"^^xsd:string .

ex:relacao_pai-do-mato_3 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:curupira ;
    ex:entidadeOrigem ex:pai-do-mato ;
    ex:motivoRelacao "Guardião da mata de função equivalente; Wikipédia trata os dois nomes como sinônimos regionais, o artbook os diferencia por corpo e método"^^xsd:string ;
    ex:tipoRelacao "variant"^^xsd:string .

ex:relacao_pai-do-mato_4 a ex:RelacaoEntreEntidades ;
    ex:entidadeDestino ex:vai-mahse ;
    ex:entidadeOrigem ex:pai-do-mato ;
    ex:motivoRelacao "Mesma função estrutural de guardião-mestre da caça que pune quem mata além do necessário, na cosmovisão desana do Rio Negro; entidade distinta, não sinônimo"^^xsd:string ;
    ex:tipoRelacao "elemental_kin"^^xsd:string .

