ex:citacao_aipo-e-tambia_1 a ex:Citacao ;
    ex:possuiAutorCitacao "«O que o vento não levou» (apud Wikipédia)"^^xsd:string ;
    ex:possuiObraCitacao "verbete «Parque Arruda Câmara»"^^xsd:string ;
    ex:possuiTextoCitacao "Diz a lenda que uma índia tabajara por nome Iapré, chorando a morte do amado que ali havia sido enterrado fez nascer uma fonte d'água de excelente qualidade"^^xsd:string .

ex:citacao_alma-de-gato_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1998 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "Ave agoureira cujo grito, semelhante ao miado de um gato, apavora as populações rurais, tomada por alma penada ou entidade que ronda as casas à noite... Sua força reside na indeterminação alucinante do pavor infantil."^^xsd:string .

ex:citacao_babau_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "O Babau é a personificação sertaneja do engolidor insaciável: mito do pavor oral que originou a clássica expressão de perda irremediável."^^xsd:string .

ex:citacao_babau_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1966 ;
    ex:possuiAutorCitacao "Hermilo Borba Filho"^^xsd:string ;
    ex:possuiObraCitacao "_Fisionomia e Espírito do Mamulengo_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas ruas e palcos do Nordeste, o Babau transita entre o assombro das noites sertanejas e o riso desenfreado dos folguedos de rua."^^xsd:string .

ex:citacao_besta-fera_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "A Besta-Fera é a transposição sertaneja do centauro mítico e do cavalo apocalíptico: a encarnação do tumulto, da corrida desabalada e do medo noturno."^^xsd:string .

ex:citacao_besta-fera_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1921 ;
    ex:possuiAutorCitacao "Gustavo Barroso"^^xsd:string ;
    ex:possuiObraCitacao "_Ao Som da Viola_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas noites de sexta-feira do sertão, o trote de ferro da Besta-Fera desafia as rezas bravas dos vaqueiros e faz tremer as paredes dos casebres."^^xsd:string .

ex:citacao_bicho-sete-cabecas_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1947 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Geografia dos Mitos Brasileiros_"^^xsd:string ;
    ex:possuiTextoCitacao "O Bicho de Sete Cabeças é a transposição sertaneja da Hidra e do Dragão medieval, personificando o obstáculo supremo que exige extrema bravura moral."^^xsd:string .

ex:citacao_bicho-sete-cabecas_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1885 ;
    ex:possuiAutorCitacao "Sílvio Romero"^^xsd:string ;
    ex:possuiObraCitacao "_Contos Populares do Brasil_"^^xsd:string ;
    ex:possuiTextoCitacao "Nos contos recolhidos no interior brasileiro, a besta de sete cabeças representa o perigo multifacetado que só a pureza de ânimo e a coragem conseguem decepar."^^xsd:string .

ex:citacao_boi-da-cara-preta_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "O Boi da Cara Preta é a mais doce e universal das figuras de acalanto do Brasil: o espanto brando que adormece as crianças sem ferir sua inocência."^^xsd:string .

ex:citacao_boi-da-cara-preta_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1981 ;
    ex:possuiAutorCitacao "Veríssimo de Melo"^^xsd:string ;
    ex:possuiObraCitacao "_Folclore Infantil_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas canções de ninar do povo brasileiro, a imagem do touro escuro sintetiza a autoridade patriarcal e o escudo protetor contra os pavores da noite."^^xsd:string .

ex:citacao_boi-espacio_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1913 ;
    ex:possuiAutorCitacao "João Simões Lopes Neto"^^xsd:string ;
    ex:possuiObraCitacao "_Lendas do Sul_"^^xsd:string ;
    ex:possuiTextoCitacao "O Boi Espácio é a alma das antigas boiadas que continuam marchando na vastidão das coxilhas sob o silêncio da noite gaúcha."^^xsd:string .

ex:citacao_boi-espacio_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1950 ;
    ex:possuiAutorCitacao "Dante de Laytano"^^xsd:string ;
    ex:possuiObraCitacao "_Folclore do Rio Grande do Sul_"^^xsd:string ;
    ex:possuiTextoCitacao "Entre os mitos pastoris do Sul, o Boi Espácio personifica a solidão dos descampados e a presença misteriosa do gado ancestral."^^xsd:string .

ex:citacao_botija_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1998 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "Botija. Tesouro enterrado, geralmente moedas de ouro ou prata guardadas em vaso de barro... A alma do finado aparece em sonho indicando o local exato. Deve-se desenterrar a sós, em segredo e em silêncio absoluto; se houver medo, indiscreção ou cobiça, o ouro se transforma em carvão."^^xsd:string .

ex:citacao_branca-dias_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1543 ;
    ex:possuiAutorCitacao "Tribunal do Santo Ofício"^^xsd:string ;
    ex:possuiObraCitacao "Processo nº 5736, Inquisição de Lisboa"^^xsd:string ;
    ex:possuiTextoCitacao "Cristã-nova, natural de Viana e moradora em Lisboa (...) acusada de judaísmo"^^xsd:string .

ex:citacao_branca-dias_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1543 ;
    ex:possuiAutorCitacao "Tribunal do Santo Ofício"^^xsd:string ;
    ex:possuiObraCitacao "Sentença de Branca Dias, Inquisição de Lisboa"^^xsd:string ;
    ex:possuiTextoCitacao "Abjuração pública, dois anos de cárcere e hábito penitencial"^^xsd:string .

ex:citacao_bruxa_1 a ex:Citacao ;
    ex:possuiAutorCitacao "A. S. Franchini"^^xsd:string ;
    ex:possuiObraCitacao "As 100 melhores lendas do folclore brasileiro"^^xsd:string ;
    ex:possuiTextoCitacao "De se transformar em coruja, morcego ou mesmo em uma mariposa negra"^^xsd:string .

ex:citacao_cabeca-satanica_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1947 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Geografia dos Mitos Brasileiros_"^^xsd:string ;
    ex:possuiTextoCitacao "A Cabeça Satânica é uma das mais pavorosas aparições das estradas noturnas: o membro cortado que corre sem pernas e apavora os viajantes com o ranger de seus dentes malditos."^^xsd:string .

ex:citacao_cabeca-satanica_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1948 ;
    ex:possuiAutorCitacao "Amadeu Amaral"^^xsd:string ;
    ex:possuiObraCitacao "_Tradições Populares_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas noites do interior, a cabeça rolante personifica o remorso insepulto e a punição sobrenatural reservada aos que quebram juramentos sagrados."^^xsd:string .

ex:citacao_caboclo-boiadeiro_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1980 ;
    ex:possuiAutorCitacao "Carlos Rodrigues Brandão"^^xsd:string ;
    ex:possuiObraCitacao "_Os Deuses do Povo_"^^xsd:string ;
    ex:possuiTextoCitacao "O Caboclo Boiadeiro é a personificação do trabalho duro, da coragem sertaneja e da sabedoria dos caminhos rurais na religiosidade brasileira."^^xsd:string .

ex:citacao_caboclo-boiadeiro_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1933 ;
    ex:possuiAutorCitacao "Mário de Andrade"^^xsd:string ;
    ex:possuiObraCitacao "_Música de Feitiçaria no Brasil_"^^xsd:string ;
    ex:possuiTextoCitacao "Nos terreiros, a linha dos Boiadeiros representa o vigor que laça a desordem e restaura a firmeza nos passos dos que caminham na terra."^^xsd:string .

ex:citacao_cabra-cabriola_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "A Cabra-Cabriola é a terrível assombração disciplinadora do Nordeste: monstro caprino que solta fogo pelas ventas e povoa as cantigas de ninar com dentes de navalha."^^xsd:string .

ex:citacao_cabra-cabriola_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1921 ;
    ex:possuiAutorCitacao "Gustavo Barroso"^^xsd:string ;
    ex:possuiObraCitacao "_Ao Som da Viola_"^^xsd:string ;
    ex:possuiTextoCitacao "Nos casebres da Caatinga, a cantiga da Cabriola mantinha as crianças em silêncio respeitoso sob a escuridão do teto de palha."^^xsd:string .

ex:citacao_cangaceiros-fantasmas_1 a ex:Citacao ;
    ex:possuiAnoCitacao 192030 ;
    ex:possuiAutorCitacao "Imprensa nordestina da época (autoria não identificada na fonte)"^^xsd:string ;
    ex:possuiObraCitacao "Citada em registro documental sobre Lampião"^^xsd:string ;
    ex:possuiTextoCitacao "O sertanejo tem sempre nos lábios uma expressão de descrença quando se lhe promette a applicação de providencias"^^xsd:string .

ex:citacao_carro-de-boi-assombrado_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "O Carro de Boi Assombrado é a mais poética e impressionante assombração das noites sertanejas: o ranger nostálgico do eixo de madeira que corta o silêncio sem tocar o solo."^^xsd:string .

ex:citacao_carro-de-boi-assombrado_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1927 ;
    ex:possuiAutorCitacao "Cornélio Pires"^^xsd:string ;
    ex:possuiObraCitacao "_Conversas ao Pé do Fogo_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas noites frias do interior, o gemido do carro fantasma trazia às taperas o eco dos tempos antigos e o mistério das estradas sem fim."^^xsd:string .

ex:citacao_comadre-fulozinha_1 a ex:Citacao ;
    ex:possuiAutorCitacao "Tradição popular nordestina"^^xsd:string ;
    ex:possuiTextoCitacao "Por isso não podemos chamá-la de caipora, senão ela nos bate com galhos de urtiga."^^xsd:string .

ex:citacao_flor-do-mato_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1890 ;
    ex:possuiAutorCitacao "Barbosa Rodrigues"^^xsd:string ;
    ex:possuiObraCitacao "_Poranduba Amazonense_"^^xsd:string ;
    ex:possuiTextoCitacao "A Flor do Mato é a encarnação poética da flora brasileira: o gênio silvestre benfazejo que defende o perfume das matas e recompensa a pureza dos simples."^^xsd:string .

ex:citacao_flor-do-mato_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1947 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Geografia dos Mitos Brasileiros_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas brumas da Serra do Mar e nos campos de Minas, o mito da donzela botânica ensina que a beleza da flor é sagrada e inviolável."^^xsd:string .

ex:citacao_fogo-corredor_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1560 ;
    ex:possuiAutorCitacao "Padre José de Anchieta"^^xsd:string ;
    ex:possuiObraCitacao "Carta de São Vicente"^^xsd:string ;
    ex:possuiTextoCitacao "Não se vê outra coisa senão um facho cintilante correndo para ali; acomete rapidamente os índios e mata-os, como os curupiras"^^xsd:string .

ex:citacao_homem-do-saco_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "O Homem do Saco é a encarnação universal do medo infantil, figura errante que delimita a fronteira segura do lar e o perigo incerto da rua."^^xsd:string .

ex:citacao_homem-do-saco_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1985 ;
    ex:possuiAutorCitacao "Roberto DaMatta"^^xsd:string ;
    ex:possuiObraCitacao "_A Casa e a Rua_"^^xsd:string ;
    ex:possuiTextoCitacao "Na transição entre a casa patriarcal e o espaço público moderno, o mito do velho andarilho funciona como sentinela pedagógica da infância."^^xsd:string .

ex:citacao_joao-sem-bracos_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "Assombração dos sertões nordestinos, fantasma de estrada que surge estático impedindo a passagem dos viandantes."^^xsd:string .

ex:citacao_lagoa-encantada-potiguara_1 a ex:Citacao ;
    ex:possuiAnoCitacao 2014 ;
    ex:possuiAutorCitacao "relato potiguara (apud Barcellos, apud Rodrigues)"^^xsd:string ;
    ex:possuiObraCitacao "«Práticas Educativo-Religiosas dos Potiguaras da Paraíba»"^^xsd:string ;
    ex:possuiTextoCitacao "A lagoa encantada é uma mina. Tem um tesouro antigo. Tem armas."^^xsd:string .

ex:citacao_lagoa-encantada-potiguara_2 a ex:Citacao ;
    ex:possuiAnoCitacao 2014 ;
    ex:possuiAutorCitacao "relato potiguara (apud Barcellos, apud Rodrigues)"^^xsd:string ;
    ex:possuiObraCitacao "«Práticas Educativo-Religiosas dos Potiguaras da Paraíba»"^^xsd:string ;
    ex:possuiTextoCitacao "Era pra ele, mas ele não sabia. Ficou lagoa encantada do índio que não tirou o dinheiro"^^xsd:string .

ex:citacao_mula-sem-cabeca_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "A Mula-sem-Cabeça é a mais popular e dramática corporificação do pecado e da penitência no Brasil: a fera de cascos de ferro e pescoço em chamas que rasga a noite das vilas coloniais."^^xsd:string .

ex:citacao_mula-sem-cabeca_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1948 ;
    ex:possuiAutorCitacao "Amadeu Amaral"^^xsd:string ;
    ex:possuiObraCitacao "_Tradições Populares_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas noites frias do interior, o relincho de fogo da mula ecoava pelas encruzilhadas como o lamento vivo das paixões condenadas."^^xsd:string .

ex:citacao_mulher-de-branco_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "A Mulher de Branco é a mais universal e poética aparição dos caminhos e casarões brasileiros: a noiva eterna cuja saudade desafia o túmulo e comove quem viaja na noite."^^xsd:string .

ex:citacao_mulher-de-branco_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1955 ;
    ex:possuiAutorCitacao "Gilberto Freyre"^^xsd:string ;
    ex:possuiObraCitacao "_Assombrações do Recife Velho_"^^xsd:string ;
    ex:possuiTextoCitacao "Nos velhos sobrados de açúcar e nos casarões de café, a presença alva da donzela perpetua os dramas trágicos da honra patriarcal."^^xsd:string .

ex:citacao_pai-do-mangue_1 a ex:Citacao ;
    ex:possuiAnoCitacao 2020 ;
    ex:possuiAutorCitacao "Dona Zita (apud Milena Veríssimo Barbosa)"^^xsd:string ;
    ex:possuiObraCitacao "«É história viva, num é história morta»"^^xsd:string ;
    ex:possuiTextoCitacao "Ele, dizem que ele é dono do mangue né? Esse cumpade aí, que é o dono do mangue, e, quando ele quer que a pessoa pesque as coisas ele não perturba."^^xsd:string .

ex:citacao_pai-do-mato_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "O Pai-do-Mato é senhor soberano da montaria bravia, cavalgando a queixada guia pelas brenhas agrestes."^^xsd:string .

ex:citacao_pai-mateus_1 a ex:Citacao ;
    ex:possuiAutorCitacao "Wikipédia"^^xsd:string ;
    ex:possuiObraCitacao "verbete «Lajedo de Pai Mateus»"^^xsd:string ;
    ex:possuiTextoCitacao "Conta a lenda que Pai Mateus seria um ermitão curandeiro que viveu naquela região por volta do século XVIII"^^xsd:string .

ex:citacao_papa-figo_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1947 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Geografia dos Mitos Brasileiros_"^^xsd:string ;
    ex:possuiTextoCitacao "O Papa-figo anda ao cair da tarde com seu surrão de couro, personificando o pavor infantil das ruas do Nordeste."^^xsd:string .

ex:citacao_pedro-malasartes_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1946 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Contos Tradicionais do Brasil_"^^xsd:string ;
    ex:possuiTextoCitacao "Pedro Malasartes é o tipo acabado do velhaco simpático, o herói popular cuja força é o engenho."^^xsd:string .

ex:citacao_pedro-malasartes_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1912 ;
    ex:possuiAutorCitacao "João Simões Lopes Neto"^^xsd:string ;
    ex:possuiObraCitacao "_Casos do Romualdo_"^^xsd:string ;
    ex:possuiTextoCitacao "Nas veredas do mundo, não há tranca de cofre nem carranca de patrão que a lábia do Malasartes não desarme."^^xsd:string .

ex:citacao_rasga-mortalha_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1954 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Dicionário do Folclore Brasileiro_"^^xsd:string ;
    ex:possuiTextoCitacao "Quando a coruja branca rasga a mortalha no céu sobre a cumeeira da casa, o sertanejo sabe que a morte vem buscar um enfermo."^^xsd:string .

ex:citacao_sopinha-e-cu-de-fogo_1 a ex:Citacao ;
    ex:possuiAnoCitacao 2020 ;
    ex:possuiAutorCitacao "Orlando Soares (apud Milena Veríssimo Barbosa)"^^xsd:string ;
    ex:possuiObraCitacao "«É história viva, num é história morta»"^^xsd:string ;
    ex:possuiTextoCitacao "Sopinha botava o mato abaixo e Cu de Fogo ia e queimava"^^xsd:string .

ex:citacao_sume_1 a ex:Citacao ;
    ex:possuiAnoCitacao 1549 ;
    ex:possuiAutorCitacao "Padre Manuel da Nóbrega"^^xsd:string ;
    ex:possuiObraCitacao "_Cartas do Brasil_"^^xsd:string ;
    ex:possuiTextoCitacao "Dizem que Sumé lhes ensinara a plantar a mandioca e lhes dera regras de convivência pacífica."^^xsd:string .

ex:citacao_sume_2 a ex:Citacao ;
    ex:possuiAnoCitacao 1947 ;
    ex:possuiAutorCitacao "Luís da Câmara Cascudo"^^xsd:string ;
    ex:possuiObraCitacao "_Geografia dos Mitos Brasileiros_"^^xsd:string ;
    ex:possuiTextoCitacao "Sumé é o clássico herói civilizador da América indígena, benfeitor incomparável das tribos tupis."^^xsd:string .

ex:citacao_tres-sao-miguel_1 a ex:Citacao ;
    ex:possuiAnoCitacao 2020 ;
    ex:possuiAutorCitacao "Orlando Soares (apud Milena Veríssimo Barbosa)"^^xsd:string ;
    ex:possuiObraCitacao "«É história viva, num é história morta»"^^xsd:string ;
    ex:possuiTextoCitacao "O São Migué, o anjo, era de carne humana, aí tiraram ele e botaram aquele que tá em São Francisco, que é o São Miguel arcanjo"^^xsd:string .

